      "post": {
        "operationId": "ask_question_api_episodes__transcript_run_id__questions_post",
        "parameters": [
          {
            "in": "path",
            "name": "transcript_run_id",
            "required": true,
            "schema": {
              "title": "Transcript Run Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionRequest"
              }
