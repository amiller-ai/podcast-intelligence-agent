# Copy this file to .env. Never commit real credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_STORE_RESPONSES=false
OPENAI_RESPONSES_TIMEOUT_SECONDS=600
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_TRANSCRIPTION_COST_PER_MINUTE_USD=0.0045
OPENAI_TRANSCRIPTION_TIMEOUT_SECONDS=600
DATABASE_PATH=data/podcast_intelligence.db
INTELLIGENCE_SEGMENT_CHARS=1600
INTELLIGENCE_MAX_QUERY_CHARS=400
INTELLIGENCE_MAX_SEARCH_RESULTS=5
INTELLIGENCE_MAX_READ_SEGMENTS=8
INTELLIGENCE_MAX_TOOL_OUTPUT_CHARS=16000
INTELLIGENCE_MAX_TOOL_CALLS=6
INTELLIGENCE_MAX_OUTPUT_TOKENS=8000
INTELLIGENCE_MAX_ANALYSIS_OUTPUT_TOKENS=25000
INTELLIGENCE_MAX_ANALYSIS_CHARS=250000
